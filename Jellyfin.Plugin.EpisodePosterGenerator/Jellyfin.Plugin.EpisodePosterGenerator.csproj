<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.EpisodePosterGenerator</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <CodeAnalysisRuleSet>../jellyfin.ruleset</CodeAnalysisRuleSet>
    <NoWarn>NU1605</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0" />
    <PackageReference Include="Jellyfin.Model" Version="12.0.0" />
    <PackageReference Include="JPKribs.Jellyfin.Base" Version="2026.7.31" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Primitives" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.EpisodePosterGenerator.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\epg_posters.html" />
    <EmbeddedResource Include="Configuration\epg_posters.js" />
    <EmbeddedResource Include="Configuration\epg_settings.html" />
    <EmbeddedResource Include="Configuration\epg_settings.js" />
    <EmbeddedResource Include="Configuration\epg_shared.css" />
    <EmbeddedResource Include="Assets\Demo\demo-base.png" />
    <EmbeddedResource Include="Assets\Demo\demo-logo.png" />
    <EmbeddedResource Include="Assets\Demo\demo-graphic.png" />
    <EmbeddedResource Include="Assets\Demo\demo-poster.jpg" />
  </ItemGroup>

</Project>