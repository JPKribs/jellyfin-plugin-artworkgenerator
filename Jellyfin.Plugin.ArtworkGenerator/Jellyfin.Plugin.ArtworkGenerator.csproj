<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.ArtworkGenerator</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <CodeAnalysisRuleSet>../jellyfin.ruleset</CodeAnalysisRuleSet>
    <NoWarn>NU1605</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.4.0">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="12.4.0">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="JPKribs.Jellyfin.Base" Version="12.4.2" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Primitives" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.ArtworkGenerator.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\*" />
    <EmbeddedResource Include="Assets\Demo\*" />
    <EmbeddedResource Include="Assets\Fonts\**\*" />
  </ItemGroup>




  <!-- The pages' strings. Base builds in Localization/*.json and these Jellyfin strings, in every language Jellyfin has. -->
  <ItemGroup>
    <JellyfinString Include="Anime" />
    <JellyfinString Include="AspectRatio" />
    <JellyfinString Include="Author" />
    <JellyfinString Include="Backdrop" />
    <JellyfinString Include="Backdrops" />
