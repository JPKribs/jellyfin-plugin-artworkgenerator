    <JellyfinString Include="ButtonArrowLeft" />
    <JellyfinString Include="ButtonArrowRight" />
    <JellyfinString Include="ButtonRemove" />
    <JellyfinString Include="ButtonRename" />
    <JellyfinString Include="Collections" />
    <JellyfinString Include="Delete" />
    <JellyfinString Include="DeleteName" />
    <JellyfinString Include="DropShadow" />
    <JellyfinString Include="Episode" />
    <JellyfinString Include="Episodes" />
    <JellyfinString Include="Folders" />
    <JellyfinString Include="HeaderSeasons" />
    <JellyfinString Include="HeaderVideos" />
    <JellyfinString Include="Images" />
    <JellyfinString Include="LabelBundled" />
    <JellyfinString Include="LabelCollection" />
    <JellyfinString Include="LabelFolder" />
    <JellyfinString Include="LabelFont" />
    <JellyfinString Include="LabelOriginalTitle" />
    <JellyfinString Include="LabelSize" />
