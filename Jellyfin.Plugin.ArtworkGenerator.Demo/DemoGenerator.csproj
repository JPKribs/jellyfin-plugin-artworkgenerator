<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.ArtworkGenerator.DemoGenerator</RootNamespace>
    <Nullable>enable</Nullable>
    <AssemblyName>generate-demos</AssemblyName>
  </PropertyGroup>

  <!-- The plugin keeps the Jellyfin packages private to its own build, so the demo, which runs the
       renderers outside a server, references them itself, plus the console logger it writes to. -->
  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.2.0" />
    <PackageReference Include="Jellyfin.Model" Version="12.2.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Jellyfin.Plugin.ArtworkGenerator/Jellyfin.Plugin.ArtworkGenerator.csproj" />
  </ItemGroup>

</Project>
