<Project Sdk="Microsoft.NET.Sdk">
  <!-- The screenshot server. It runs the plugin's own code for the read-only routes. It is not in the plugin's
       solution or build, and nothing here goes into the plugin zip. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.4.0" />
    <PackageReference Include="Jellyfin.Model" Version="12.4.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../Jellyfin.Plugin.ArtworkGenerator/Jellyfin.Plugin.ArtworkGenerator.csproj" />
  </ItemGroup>
</Project>
